rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /games/{gameId}/...
    // Game covers, screenshots, and video uploads
    // - Publicly readable
    // - Writable only by admins verified via Firestore users/{uid}.role
    // ─────────────────────────────────────────────────────────────────────────
    match /games/{gameId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
